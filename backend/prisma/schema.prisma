generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum TimeOffRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REFUSED
  CANCELLED
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

enum SalaryRuleType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  NET
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)

  employee Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id           Int    @id @default(autoincrement())
  employeeCode String @unique

  firstName   String
  lastName    String
  email       String    @unique
  phone       String?
  dateOfBirth DateTime?
  joiningDate DateTime?
  jobTitle    String?

  bankName      String?
  bankAccountNo String?
  bankIfsc      String?

  status EmployeeStatus @default(ACTIVE)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  contracts         Contract[]
  attendances       Attendance[]
  timeOffRequests   TimeOffRequest[]
  allocations       TimeOffAllocation[]
  payslips          Payslip[]
  employeeSchedules EmployeeSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
}

model Contract {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime?

  wage           Decimal        @db.Decimal(12, 2)
  employmentType EmploymentType @default(FULL_TIME)
  status         ContractStatus @default(DRAFT)

  salaryStructureId Int?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([startDate, endDate])
}

model WorkingSchedule {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  days ScheduleDay[]

  employees EmployeeSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleDay {
  id Int @id @default(autoincrement())

  scheduleId Int
  schedule   WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  dayOfWeek    Int
  startTime    String
  endTime      String
  breakMinutes Int    @default(60)

  @@unique([scheduleId, dayOfWeek])
}

model EmployeeSchedule {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  scheduleId Int
  schedule   WorkingSchedule @relation(fields: [scheduleId], references: [id])

  startDate DateTime
  endDate   DateTime?

  @@index([employeeId])
  @@index([scheduleId])
}

model Attendance {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attendanceDate DateTime
  checkIn        DateTime?
  checkOut       DateTime?

  workedHours Decimal          @default(0) @db.Decimal(5, 2)
  status      AttendanceStatus @default(PRESENT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([employeeId, attendanceDate])
  @@index([status])
}

model TimeOffType {
  id Int @id @default(autoincrement())

  name        String  @unique
  code        String  @unique
  description String?

  annualAllowance Decimal? @db.Decimal(8, 2)
  isPaid          Boolean  @default(true)

  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeOffAllocation {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  timeOffTypeId Int
  timeOffType   TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  allocatedDays Decimal @db.Decimal(8, 2)
  usedDays      Decimal @default(0) @db.Decimal(8, 2)

  year Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, timeOffTypeId, year])
  @@index([employeeId])
}

model TimeOffRequest {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  timeOffTypeId Int
  timeOffType   TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  startDate DateTime
  endDate   DateTime
  days      Decimal  @db.Decimal(5, 2)

  reason String?
  status TimeOffRequestStatus @default(DRAFT)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([startDate, endDate])
  @@index([status])
}

model SalaryStructure {
  id Int @id @default(autoincrement())

  name        String  @unique
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  contracts Contract[]
  rules     SalaryRule[]
  payruns   Payrun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalaryRule {
  id Int @id @default(autoincrement())

  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  name     String
  code     String
  sequence Int    @default(10)

  type     SalaryRuleType
  category SalaryRuleCategory

  amount     Decimal? @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(8, 4)
  formula    String?

  isActive Boolean @default(true)

  payslipLines PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salaryStructureId, code])
  @@index([salaryStructureId, sequence])
}

model Payrun {
  id Int @id @default(autoincrement())

  name String

  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  status PayrunStatus @default(DRAFT)

  computedAt  DateTime?
  validatedAt DateTime?
  paidAt      DateTime?

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salaryStructureId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model Payslip {
  id Int @id @default(autoincrement())

  payslipNumber String @unique

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  payrunId Int
  payrun   Payrun @relation(fields: [payrunId], references: [id], onDelete: Cascade)

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  grossSalary     Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netSalary       Decimal @default(0) @db.Decimal(12, 2)

  pdfPath     String?
  emailSentAt DateTime?

  lines PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodStart, periodEnd])
  @@index([payrunId])
  @@index([employeeId])
}

model PayslipLine {
  id Int @id @default(autoincrement())

  payslipId Int
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  salaryRuleId Int?
  salaryRule   SalaryRule? @relation(fields: [salaryRuleId], references: [id])

  name String
  code String

  category SalaryRuleCategory
  sequence Int

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([payslipId])
  @@index([salaryRuleId])
}

model AuditLog {
  id Int @id @default(autoincrement())

  userId      Int?
  action      String
  entity      String
  entityId    Int?
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
